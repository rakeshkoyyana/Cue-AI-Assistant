{
  "name": "cmodule",
  "version": "0.6.0",
  "description": "System utility layer context module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "icons": "node tools/build-icons.js",
    "test:smoke": "xvfb-run -a electron --no-sandbox tools/smoke.js",
    "test:video": "node tools/video-test.js",
    "test:analyzer": "node tools/analyzer-test.js",
    "test:catalog": "node tools/catalog-test.js",
    "mac": "electron-builder --mac dir",
    "install-mac": "bash tools/install-mac.sh",
    "icon": "xvfb-run -a electron --no-sandbox tools/render-icon.js || electron tools/render-icon.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "lucide-static": "^1.52.0"
  },
  "build": {
    "appId": "com.rakesh.cmodule",
    "productName": "cmodule",
    "files": [
      "main.js",
      "preload.js",
      "cloud.js",
      "video.js",
      "analyzer.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "cmodule requires system accessibility access to parse real-time session inputs.",
        "NSScreenCaptureUsageDescription": "cmodule requires layout sequence visibility to extract temporary analysis elements.",
        "LSUIElement": false
      }
    },
    "compression": "store"
  }
}
