{
  "name": "cue",
  "version": "0.4.0",
  "description": "Cue AI \u2014 a self-hosted interview and meeting copilot (fast cloud mode on free tiers)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "icons": "node tools/build-icons.js",
    "test:smoke": "xvfb-run -a electron --no-sandbox tools/smoke.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "lucide-static": "^1.52.0"
  },
  "build": {
    "appId": "com.rakesh.cue",
    "productName": "Cue",
    "files": [
      "main.js",
      "preload.js",
      "cloud.js",
      "renderer/**/*",
      "package.json"
    ]
  }
}
