{
  "name": "cue",
  "version": "0.6.0",
  "description": "Cue AI \u2014 a self-hosted interview and meeting copilot (fast cloud mode on free tiers)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "icons": "node tools/build-icons.js",
    "test:smoke": "xvfb-run -a electron --no-sandbox tools/smoke.js",
    "test:video": "node tools/video-test.js",
    "mac": "electron-builder --mac dir",
    "install-mac": "bash tools/install-mac.sh",
    "icon": "xvfb-run -a electron --no-sandbox tools/render-icon.js || electron tools/render-icon.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "lucide-static": "^1.52.0"
  },
  "build": {
    "appId": "com.rakesh.cueai",
    "productName": "Cue AI",
    "files": [
      "main.js",
      "preload.js",
      "cloud.js",
      "video.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Cue AI listens to your microphone to transcribe the call.",
        "NSScreenCaptureUsageDescription": "Cue AI captures system audio and screenshots during a session.",
        "LSUIElement": false
      }
    },
    "compression": "store"
  }
}
